# -----------------------------
# 0. Imports & Setup
# -----------------------------
import pandas as pd
import numpy as np

from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler, OneHotEncoder
from sklearn.compose import ColumnTransformer
from sklearn.pipeline import Pipeline

from sklearn.linear_model import LinearRegression, Lasso, LogisticRegression
from sklearn.ensemble import RandomForestRegressor, RandomForestClassifier
from sklearn.cluster import KMeans
from sklearn.decomposition import PCA

from sklearn.metrics import (
    mean_squared_error, mean_absolute_error, r2_score,
    accuracy_score, precision_score, recall_score, f1_score, roc_auc_score
)

import matplotlib.pyplot as plt
import seaborn as sns

plt.style.use("ggplot")

# -----------------------------
# 1. Load Dataset
# -----------------------------
df = pd.read_csv("Electric_Vehicle_Population_Data.csv")

df.columns = [c.strip().lower().replace(" ", "_") for c in df.columns]

# ============================================================
# QUESTION 1: LASSO vs OLS — Predicting Electric Range
# ============================================================

q1_cols = [
    "make", "model_year", "electric_vehicle_type",
    "base_msrp", "electric_range", "electric_utility", "cafv_eligibility"
]

q1_df = df[q1_cols].dropna()
q1_df = q1_df[q1_df["electric_range"] > 0]

X_q1 = q1_df.drop("electric_range", axis=1)
y_q1 = q1_df["electric_range"]

num_q1 = ["model_year", "base_msrp"]
cat_q1 = ["make", "electric_vehicle_type", "electric_utility", "cafv_eligibility"]

pre_q1 = ColumnTransformer([
    ("num", StandardScaler(), num_q1),
    ("cat", OneHotEncoder(handle_unknown="ignore"), cat_q1)
])

X_train_q1, X_test_q1, y_train_q1, y_test_q1 = train_test_split(
    X_q1, y_q1, test_size=0.2, random_state=42
)

# ----- OLS -----
ols = Pipeline([
    ("pre", pre_q1),
    ("model", LinearRegression())
])
ols.fit(X_train_q1, y_train_q1)
ols_pred = ols.predict(X_test_q1)

print("OLS MSE:", mean_squared_error(y_test_q1, ols_pred))

# ----- LASSO -----
lasso = Pipeline([
    ("pre", pre_q1),
    ("model", Lasso(alpha=0.1, max_iter=10000))
])
lasso.fit(X_train_q1, y_train_q1)
lasso_pred = lasso.predict(X_test_q1)

print("LASSO MSE:", mean_squared_error(y_test_q1, lasso_pred))

# ----- LASSO Coefficients -----
pre_q1.fit(X_train_q1)
X_train_trans = pre_q1.transform(X_train_q1)

lasso_raw = Lasso(alpha=0.1, max_iter=10000)
lasso_raw.fit(X_train_trans, y_train_q1)

num_names = num_q1
cat_names = pre_q1.named_transformers_["cat"].get_feature_names_out(cat_q1)
feature_names = np.concatenate([num_names, cat_names])

coef_series = pd.Series(lasso_raw.coef_, index=feature_names)
nonzero = coef_series[coef_series != 0].sort_values()

plt.figure(figsize=(8,6))
nonzero.plot(kind="barh")
plt.title("LASSO Non-Zero Coefficients — Electric Range")
plt.tight_layout()
plt.show()

# ============================================================
# QUESTION 2: K-Means Clustering + PCA
# ============================================================

q2_cols = ["model_year", "electric_range", "base_msrp", "electric_utility", "cafv_eligibility", "county"]
q2_df = df[q2_cols].dropna()
q2_df = q2_df[(q2_df["electric_range"] > 0) & (q2_df["base_msrp"] > 0)]

X_q2 = q2_df[["model_year", "electric_range", "base_msrp"]]
X_scaled = StandardScaler().fit_transform(X_q2)

# ----- K-Means -----
kmeans = KMeans(n_clusters=3, random_state=42, n_init=10)
q2_df["cluster"] = kmeans.fit_predict(X_scaled)

# ----- PCA -----
pca = PCA(n_components=2)
pcs = pca.fit_transform(X_scaled)
q2_df["pc1"] = pcs[:,0]
q2_df["pc2"] = pcs[:,1]

plt.figure(figsize=(8,6))
sns.scatterplot(data=q2_df.sample(5000), x="pc1", y="pc2", hue="cluster", palette="Set1")
plt.title("PCA Projection of K-Means Clusters")
plt.tight_layout()
plt.show()

# ----- Boxplots -----
plt.figure(figsize=(8,6))
sns.boxplot(data=q2_df, x="cluster", y="base_msrp")
plt.title("MSRP by Cluster (Luxury vs Utility)")
plt.tight_layout()
plt.show()

plt.figure(figsize=(8,6))
sns.boxplot(data=q2_df, x="cluster", y="electric_range")
plt.title("Electric Range by Cluster")
plt.tight_layout()
plt.show()

# ============================================================
# QUESTION 3: Classifying BEV vs PHEV
# ============================================================

q3_cols = [
    "electric_vehicle_type", "model_year", "base_msrp", "electric_range",
    "county", "state", "cafv_eligibility", "make", "electric_utility"
]

q3_df = df[q3_cols].dropna()
q3_df = q3_df[q3_df["electric_vehicle_type"].isin(["Battery Electric Vehicle (BEV)", "Plug-in Hybrid Electric Vehicle (PHEV)"])]

X_q3 = q3_df.drop("electric_vehicle_type", axis=1)
y_q3 = q3_df["electric_vehicle_type"].replace({
    "Battery Electric Vehicle (BEV)": 1,
    "Plug-in Hybrid Electric Vehicle (PHEV)": 0
})

num_q3 = ["model_year", "base_msrp", "electric_range"]
cat_q3 = ["county", "state", "cafv_eligibility", "make", "electric_utility"]

pre_q3 = ColumnTransformer([
    ("num", StandardScaler(), num_q3),
    ("cat", OneHotEncoder(handle_unknown="ignore"), cat_q3)
])

X_train_q3, X_test_q3, y_train_q3, y_test_q3 = train_test_split(
    X_q3, y_q3, test_size=0.2, random_state=42, stratify=y_q3
)

# ----- Logistic Regression -----
logreg = Pipeline([
    ("pre", pre_q3),
    ("model", LogisticRegression(max_iter=1000))
])
logreg.fit(X_train_q3, y_train_q3)
log_pred = logreg.predict(X_test_q3)
log_prob = logreg.predict_proba(X_test_q3)[:,1]

# ----- Random Forest -----
rf = Pipeline([
    ("pre", pre_q3),
    ("model", RandomForestClassifier(n_estimators=300, random_state=42))
])
rf.fit(X_train_q3, y_train_q3)
rf_pred = rf.predict(X_test_q3)
rf_prob = rf.predict_proba(X_test_q3)[:,1]

# ----- Metrics -----
print("LogReg Accuracy:", accuracy_score(y_test_q3, log_pred))
print("RF Accuracy:", accuracy_score(y_test_q3, rf_pred))

metrics = pd.DataFrame({
    "Model": ["Logistic Regression", "Random Forest"],
    "Accuracy": [
        accuracy_score(y_test_q3, log_pred),
        accuracy_score(y_test_q3, rf_pred)
    ],
    "Precision": [
        precision_score(y_test_q3, log_pred),
        precision_score(y_test_q3, rf_pred)
    ],
    "Recall": [
        recall_score(y_test_q3, log_pred),
        recall_score(y_test_q3, rf_pred)
    ],
    "F1": [
        f1_score(y_test_q3, log_pred),
        f1_score(y_test_q3, rf_pred)
    ]
})

metrics_melt = metrics.melt(id_vars="Model", var_name="Metric", value_name="Score")

plt.figure(figsize=(8,6))
sns.barplot(data=metrics_melt, x="Metric", y="Score", hue="Model")
plt.title("Classification Metrics: Logistic Regression vs Random Forest")
plt.ylim(0,1)
plt.tight_layout()
plt.show()

# ============================================================
# QUESTION 4: Predicting Base MSRP (Regression)
# ============================================================

q4_cols = [
    "base_msrp", "model_year", "electric_range",
    "county", "state", "cafv_eligibility", "make", "electric_utility"
]

q4_df = df[q4_cols].dropna()
q4_df = q4_df[(q4_df["base_msrp"] > 0) & (q4_df["electric_range"] > 0)]

X_q4 = q4_df.drop("base_msrp", axis=1)
y_q4 = q4_df["base_msrp"]

num_q4 = ["model_year", "electric_range"]
cat_q4 = ["county", "state", "cafv_eligibility", "make", "electric_utility"]

pre_q4 = ColumnTransformer([
    ("num", StandardScaler(), num_q4),
    ("cat", OneHotEncoder(handle_unknown="ignore"), cat_q4)
])

X_train_q4, X_test_q4, y_train_q4, y_test_q4 = train_test_split(
    X_q4, y_q4, test_size=0.2, random_state=42
)

# ----- Linear Regression -----
linreg = Pipeline([
    ("pre", pre_q4),
    ("model", LinearRegression())
])
linreg.fit(X_train_q4, y_train_q4)
lin_pred = linreg.predict(X_test_q4)

print("Linear RMSE:", mean_squared_error(y_test_q4, lin_pred, squared=False))

# ----- Random Forest Regressor -----
rf_reg = Pipeline([
    ("pre", pre_q4),
    ("model", RandomForestRegressor(n_estimators=300, random_state=42))
])
rf_reg.fit(X_train_q4, y_train_q4)
rf_pred = rf_reg.predict(X_test_q4)

print("RF RMSE:", mean_squared_error(y_test_q4, rf_pred, squared=False))

# ----- Predicted vs Actual -----
plt.figure(figsize=(8,6))
sns.scatterplot(x=y_test_q4, y=rf_pred, alpha=0.4)
plt.plot([y_test_q4.min(), y_test_q4.max()],
         [y_test_q4.min(), y_test_q4.max()], "k--")
plt.title("Predicted vs Actual Base MSRP (Random Forest)")
plt.xlabel("Actual")
plt.ylabel("Predicted")
plt.tight_layout()
plt.show()

